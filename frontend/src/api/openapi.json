{
 "openapi": "3.1.0",
 "info": {
  "title": "GrammarGuard",
  "description": "\nFormal guarantees for LLM output, and formal QA for the validators behind them.\n\n* **Automata**: regex -> \u03b5-NFA -> DFA -> minimal DFA, membership with state paths.\n* **Constraint algebra**: combine regular languages with \u2229 \u222a \u2212 \u00ac (product / complement constructions).\n* **Validator Lab**: diff two validators with counterexamples; synthesize test suites.\n* **Generate**: stream GPT-2 output constrained by a DFA or a JSON PDA, with per-token\n  *constraint pressure* telemetry and verifiable certificates.\n",
  "version": "2.0.0.dev0"
 },
 "paths": {
  "/api/v1/compile": {
   "post": {
    "tags": [
     "automata"
    ],
    "summary": "Regex -> \u03b5-NFA -> DFA -> minimal DFA",
    "description": "Run the whole pipeline (Thompson, subset construction, table-filling) and return each automaton\nas DOT text, a transition list and state counts.",
    "operationId": "compile_regex_api_v1_compile_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CompileRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CompileResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/membership": {
   "post": {
    "tags": [
     "automata"
    ],
    "summary": "Run a string through the DFA",
    "description": "Accepted or not, with the state path. The path is also returned as a verifiable certificate.",
    "operationId": "membership_api_v1_membership_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/MembershipRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MembershipResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/certificate/verify": {
   "post": {
    "tags": [
     "automata"
    ],
    "summary": "Re-check a certificate",
    "description": "Rebuild the automaton from the constraint text inside the certificate and replay the recorded run.\nNo language model is involved.",
    "operationId": "verify_certificate_api_v1_certificate_verify_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CertificateVerifyRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CertificateVerifyResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/builtins": {
   "get": {
    "tags": [
     "algebra"
    ],
    "summary": "Named constraints usable in expressions",
    "description": "The built-in names (digit, email, iso_date, ...) and the regex behind each.",
    "operationId": "builtins_api_v1_builtins_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BuiltinsResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/algebra": {
   "post": {
    "tags": [
     "algebra"
    ],
    "summary": "Evaluate a constraint expression",
    "description": "Combine regular languages with \u2229 \u222a \u2212 \u00ac concat star (product / complement constructions), minimize,\nand describe the result: size, examples, an equivalent regex (state elimination).",
    "operationId": "evaluate_expression_api_v1_algebra_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AlgebraRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AlgebraResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/equivalence": {
   "post": {
    "tags": [
     "algebra"
    ],
    "summary": "Are two constraints the same language?",
    "description": "L1 = L2 iff their symmetric difference is empty; otherwise a shortest string in it is returned.",
    "operationId": "check_equivalence_api_v1_equivalence_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/EquivalenceRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EquivalenceResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/count": {
   "post": {
    "tags": [
     "algebra"
    ],
    "summary": "Count and sample the language",
    "description": "Number of accepted strings of each length (dynamic programming over the DFA, over the constraint's own\nalphabet), whether the language is finite, and exact uniform samples of one length.",
    "operationId": "count_api_v1_count_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CountRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CountResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/validators/diff": {
   "post": {
    "tags": [
     "validators"
    ],
    "summary": "Compare an old and a new validator",
    "description": "Closure properties in action: L_old \u2212 L_new, L_new \u2212 L_old and L_old \u2229 L_new are each a product DFA;\na non-empty one is searched (BFS) for its shortest strings, which are the witnesses.",
    "operationId": "diff_api_v1_validators_diff_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DiffRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DiffResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/validators/testgen": {
   "post": {
    "tags": [
     "validators"
    ],
    "summary": "Synthesize a test suite with transition coverage",
    "description": "Positive cases covering every DFA transition, plus boundary / substitution / deletion / truncation\nnegatives. Optionally exported as CSV or as a ready-to-run pytest file.",
    "operationId": "generate_test_suite_api_v1_validators_testgen_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TestgenRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TestgenResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/learn/subset": {
   "get": {
    "tags": [
     "learn"
    ],
    "summary": "Subset construction, step by step",
    "description": "Each record is one (subset S, symbol a) step: move(S, a), its \u03b5-closure, and whether it is a new DFA state.\nThe trace is produced by the real algorithm.",
    "operationId": "subset_api_v1_learn_subset_get",
    "parameters": [
     {
      "name": "regex",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "examples": [
        "(a|b)*abb"
       ],
       "title": "Regex"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LearnSubsetResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/learn/minimize": {
   "get": {
    "tags": [
     "learn"
    ],
    "summary": "Table-filling minimization, round by round",
    "description": "Round 0 marks pairs split by acceptance; each later round marks pairs that reach a marked pair on some\nsymbol. Unmarked pairs are merged.",
    "operationId": "minimization_api_v1_learn_minimize_get",
    "parameters": [
     {
      "name": "regex",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "examples": [
        "(a|b)*abb"
       ],
       "title": "Regex"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LearnMinimizeResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/generate": {
   "post": {
    "tags": [
     "generate"
    ],
    "summary": "Stream a DFA-constrained generation (SSE)",
    "description": "Streams `meta`, then `token` events (text, DFA state, #allowed tokens, constraint-pressure telemetry),\nthen `done` with the full text, whether it matches, a pressure summary and a verifiable certificate.\nWith `compare` an unconstrained run is streamed first (events carry `source`).",
    "operationId": "generate_api_v1_generate_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/GenerateRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/generate/json": {
   "post": {
    "tags": [
     "generate"
    ],
    "summary": "Stream a PDA-constrained JSON generation (SSE)",
    "description": "Like `/generate`, but the constraint is the JSON grammar (or a mini JSON schema compiled to an LL(1)\ngrammar). Token events carry the PDA stack, how many tokens were checked, and whether the full-vocabulary\nfallback was needed.",
    "operationId": "generate_json_api_v1_generate_json_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/JsonGenerateRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/generate/batch": {
   "post": {
    "tags": [
     "generate"
    ],
    "summary": "Several distinct valid samples (synthetic test data)",
    "description": "Runs constrained generation with different seeds until `count` DISTINCT strings that end in an accepting\nstate are found (at most 3x`count` attempts, within the time limit). Useful as synthetic test data for a\nvalidator: every sample is guaranteed to match.",
    "operationId": "generate_batch_api_v1_generate_batch_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/BatchRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BatchResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/benchmarks": {
   "get": {
    "tags": [
     "benchmarks"
    ],
    "summary": "Evaluation results: validity, cost and speed of constrained vs unconstrained decoding",
    "description": "The full results document (`meta`, `cases`, `runs`, `summary`) from the last benchmark run.\nEvery run, including the generated text, is included so the numbers can be audited.",
    "operationId": "benchmarks_api_v1_benchmarks_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Benchmarks Api V1 Benchmarks Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/system/health": {
   "get": {
    "tags": [
     "system"
    ],
    "summary": "Liveness and model state",
    "description": "Always 200 while the server is up; `engine.loaded` tells whether the language model has finished loading.",
    "operationId": "health_api_v1_system_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/system/models": {
   "get": {
    "tags": [
     "system"
    ],
    "summary": "Configured model and limits",
    "description": "The model in use and the limits the server enforces (so a UI can validate before sending).",
    "operationId": "models_api_v1_system_models_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Models Api V1 System Models Get"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "AlgebraRequest": {
    "properties": {
     "expression": {
      "type": "string",
      "title": "Expression",
      "examples": [
       "email & !contains(/competitor/) & length(5, 40)"
      ]
     },
     "names": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Names"
     },
     "examples": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 0.0,
      "title": "Examples",
      "default": 8
     }
    },
    "type": "object",
    "required": [
     "expression"
    ],
    "title": "AlgebraRequest",
    "description": "Evaluate a constraint expression."
   },
   "AlgebraResponse": {
    "properties": {
     "expression": {
      "type": "string",
      "title": "Expression"
     },
     "dfa": {
      "$ref": "#/components/schemas/AutomatonView"
     },
     "steps": {
      "items": {
       "$ref": "#/components/schemas/AlgebraStep"
      },
      "type": "array",
      "title": "Steps"
     },
     "finite": {
      "type": "boolean",
      "title": "Finite"
     },
     "size": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Size",
      "description": "number of strings if the language is finite (over its own alphabet)"
     },
     "regex": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Regex",
      "description": "an equivalent regex (Kleene's theorem), when one can be written"
     },
     "regex_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Regex Note"
     },
     "examples": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Examples"
     },
     "counts": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Counts",
      "description": "number of accepted strings of length 0..12"
     }
    },
    "type": "object",
    "required": [
     "expression",
     "dfa",
     "steps",
     "finite",
     "examples",
     "counts"
    ],
    "title": "AlgebraResponse",
    "description": "Minimal DFA of the expression and what can be said about its language."
   },
   "AlgebraStep": {
    "properties": {
     "expr": {
      "type": "string",
      "title": "Expr"
     },
     "operation": {
      "type": "string",
      "title": "Operation"
     },
     "states": {
      "type": "integer",
      "title": "States"
     }
    },
    "type": "object",
    "required": [
     "expr",
     "operation",
     "states"
    ],
    "title": "AlgebraStep",
    "description": "One closure construction used while evaluating."
   },
   "AutomatonView": {
    "properties": {
     "states": {
      "type": "integer",
      "title": "States"
     },
     "live_states": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Live States"
     },
     "start": {
      "type": "integer",
      "title": "Start"
     },
     "accepting": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Accepting"
     },
     "dot": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Dot",
      "description": "Graphviz DOT; null when the automaton is too large to draw"
     },
     "transitions": {
      "items": {
       "$ref": "#/components/schemas/Transition"
      },
      "type": "array",
      "title": "Transitions"
     },
     "state_labels": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "State Labels",
      "description": "NFA state sets / merged states"
     }
    },
    "type": "object",
    "required": [
     "states",
     "start",
     "accepting",
     "transitions"
    ],
    "title": "AutomatonView",
    "description": "A DFA or NFA ready to display."
   },
   "BatchRequest": {
    "properties": {
     "constraint": {
      "$ref": "#/components/schemas/Constraint"
     },
     "prompt": {
      "type": "string",
      "title": "Prompt",
      "default": ""
     },
     "count": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Count",
      "default": 5
     },
     "max_tokens": {
      "type": "integer",
      "maximum": 1000.0,
      "minimum": 1.0,
      "title": "Max Tokens",
      "default": 40
     },
     "top_k": {
      "type": "integer",
      "maximum": 200.0,
      "minimum": 2.0,
      "title": "Top K",
      "default": 20
     },
     "temperature": {
      "type": "number",
      "maximum": 5.0,
      "exclusiveMinimum": 0.0,
      "title": "Temperature",
      "default": 1.0
     },
     "seed": {
      "type": "integer",
      "title": "Seed",
      "default": 0
     },
     "certificates": {
      "type": "boolean",
      "title": "Certificates",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "constraint"
    ],
    "title": "BatchRequest",
    "description": "Several distinct valid samples (synthetic test data)."
   },
   "BatchResponse": {
    "properties": {
     "samples": {
      "items": {
       "$ref": "#/components/schemas/BatchSample"
      },
      "type": "array",
      "title": "Samples"
     },
     "requested": {
      "type": "integer",
      "title": "Requested"
     },
     "attempts": {
      "type": "integer",
      "title": "Attempts"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "samples",
     "requested",
     "attempts"
    ],
    "title": "BatchResponse",
    "description": "Distinct samples that ended in an accepting state."
   },
   "BatchSample": {
    "properties": {
     "text": {
      "type": "string",
      "title": "Text"
     },
     "seed": {
      "type": "integer",
      "title": "Seed"
     },
     "cost_bits": {
      "type": "number",
      "title": "Cost Bits"
     },
     "certificate": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Certificate"
